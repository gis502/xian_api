<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DataManagementMapper">

    <select id="selectTable" resultType="java.util.Map">
        SELECT
        table_name AS "tableName",
        obj_description(
        ('"' || table_schema || '"."' || table_name || '"')::regclass,
        'pg_class'
        ) AS "remark"
        FROM information_schema.tables
        WHERE table_catalog = current_database()
        AND table_schema = 'public'
        <if test="remark != null and remark != ''">
            AND obj_description(('"' || table_schema || '"."' || table_name || '"')::regclass, 'pg_class')
            LIKE CONCAT('%', REPLACE(#{remark}, '"', ''), '%')
        </if>
        <if test="remark == null or remark == ''">
            AND obj_description(('"' || table_schema || '"."' || table_name || '"')::regclass, 'pg_class') IS NOT NULL
        </if>
        ORDER BY table_schema, table_name
    </select>

    <select id="selectTableList" resultType="java.util.Map">
        SELECT * FROM ${tableName}
        <!-- 动态生成模糊查询条件 -->
        <where>
            <if test='queryInfo != null and queryInfo != ""'>
                <foreach collection="fieldList" item="col" separator=" OR ">
                    (${col} LIKE CONCAT('%', '${queryInfo}', '%'))
                </foreach>
            </if>
        </where>
        <!-- 动态添加排序：主键列表非空时按主键排序 -->
        <if test="primaryKey != null and primaryKey.size() > 0">
            ORDER BY
            <foreach collection="primaryKey" item="pk" separator=",">
                ${pk}
            </foreach>
            DESC
        </if>
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="selectKeyInfo" resultType="java.util.Map">
        SELECT
            a.attname AS "key",  -- 字段名
            col_description(a.attrelid, a.attnum) AS "value",  -- 字段注释
            t.typname AS "type"  -- 字段类型
        FROM
            pg_class c
                JOIN
            pg_attribute a ON a.attrelid = c.oid
                JOIN
            pg_type t ON a.atttypid = t.oid  -- 关联类型表获取字段类型
        WHERE
            c.relname = #{tableName}  -- 表名
          AND a.attnum > 0  -- 排除系统字段
          AND NOT a.attisdropped  -- 排除已删除字段
        ORDER BY
            a.attnum;  -- 按字段顺序排列
    </select>

    <select id="selectPrimaryKey" resultType="java.util.Map">
        SELECT
            pg_attribute.attname AS primaryKey
        FROM
            pg_index
                JOIN
            pg_class ON pg_index.indrelid = pg_class.oid
                JOIN
            pg_attribute ON pg_attribute.attrelid = pg_class.oid
                AND pg_attribute.attnum = ANY(pg_index.indkey)
        WHERE
            pg_class.relname = #{tableName}
          AND pg_index.indisprimary -- 只查询主键
        ORDER BY
            pg_attribute.attnum -- 按字段顺序排列（针对联合主键）
    </select>

    <select id="selectAllPage" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ${tableName}
    </select>

    <select id="selectDeletedRecords" resultType="java.util.Map">
        SELECT * FROM ${tableName}
        WHERE
        <foreach collection="conditions" item="conditionMap" separator="OR" open="(" close=")">
            <foreach collection="conditionMap" item="value" index="key" separator="AND" open="(" close=")">
                <if test='value != null and value != ""'>
                    ${key} = #{value}
                </if>
            </foreach>
        </foreach>
    </select>

    <delete id="deleteInfo">
        DELETE FROM ${tableName}
        WHERE
        <foreach collection="conditions" item="conditionMap" separator="OR" open="(" close=")">
            <foreach collection="conditionMap" item="value" index="key" separator="AND" open="(" close=")">
                <if test='value != null and value != ""'>
                    ${key} = #{value}
                </if>
            </foreach>
        </foreach>
    </delete>

    <insert id="addInfo">
        INSERT INTO ${tableName} (
        <foreach collection="datas[0].keySet()" item="field" separator=",">
            ${field}
        </foreach>
        ) VALUES
        <foreach collection="datas" item="data" separator=",">
            (
            <!-- 关键修复：用index对应Map的key，item对应value，移除无效的key属性 -->
            <foreach collection="data.entrySet()" index="entryKey" item="entryValue" separator=",">
                <choose>
                    <!-- 数字类型判断：用index对应的entryKey获取字段类型 -->
                    <when test="fieldTypes[entryKey].matches('.*(int4|int8|float4|float8|numeric|decimal).*')">
                        #{entryValue, jdbcType=NUMERIC}
                    </when>
                    <!-- 时间类型判断 -->
                    <when test="fieldTypes[entryKey].matches('.*timestamp.*')">
                        to_timestamp(#{entryValue}, 'yyyy-MM-dd HH24:mi:ss')
                    </when>
                    <!-- 地理信息类型判断 -->
                    <when test="fieldTypes[entryKey].matches('.*geometry.*')">
                        <choose>
                            <when test="entryValue.toString().matches('.*(POINT|LINESTRING|POLYGON|MULTIPOINT|MULTILINESTRING|MULTIPOLYGON).*')">
                                ST_GeomFromText(#{entryValue}, 4490)
                            </when>
                            <otherwise>
                                ST_GeomFromWKB(decode(#{entryValue}, 'hex'), 4490)
                            </otherwise>
                        </choose>
                    </when>
                    <!-- 其他类型默认处理 -->
                    <otherwise>
                        #{entryValue}
                    </otherwise>
                </choose>
            </foreach>
            )
        </foreach>
    </insert>

    <!-- 1. 按主键ID更新（idName和id匹配） -->
    <update id="updateInfo1">
        UPDATE ${tableName}
        <set>
            <foreach collection="fieldNames" item="fieldName" index="index" separator=",">
                <choose>
                    <!-- 适配WKB十六进制字符串格式（优先推荐） -->
                    <when test='fieldTypes[fieldName] == "geometry"'>
                        ${fieldName} = ST_GeomFromWKB(decode(#{fieldValues[${index}]}, 'hex'), 4490)
                    </when>
                    <when test='fieldTypes[fieldName] == "int4"'>
                        ${fieldName} = CAST(#{fieldValues[${index}]} AS INTEGER)
                    </when>
                    <when test='fieldTypes[fieldName] == "int8"'>
                        ${fieldName} = CAST(#{fieldValues[${index}]} AS BIGINT)
                    </when>
                    <when test='fieldTypes[fieldName] == "timestamp" or fieldTypes[fieldName] == "timestamp without time zone"'>
                        ${fieldName} = TO_TIMESTAMP(#{fieldValues[${index}]}, 'yyyy-MM-dd"T"HH24:mi:ss.MSXXX')
                        + INTERVAL '8 hours'
                    </when>
                    <when test='fieldTypes[fieldName] == "numeric" or fieldTypes[fieldName] == "decimal" or fieldTypes[fieldName] == "float8"'>
                        ${fieldName} = CAST(#{fieldValues[${index}]} AS NUMERIC)
                    </when>
                    <otherwise>
                        ${fieldName} = #{fieldValues[${index}]}
                    </otherwise>
                </choose>
            </foreach>
        </set>
        WHERE
        <foreach collection="idName" item="idCol" index="index" separator="AND">
            <choose>
                <when test='fieldTypes[idCol] == "int4"'>
                    ${idCol} = CAST(#{id[${index}]} AS INTEGER)
                </when>
                <when test='fieldTypes[idCol] == "int8"'>
                    ${idCol} = CAST(#{id[${index}]} AS BIGINT)
                </when>
                <otherwise>
                    ${idCol} = #{id[${index}]}
                </otherwise>
            </choose>
        </foreach>
    </update>

    <!-- 2. 按旧数据匹配更新（oldData作为条件） -->
    <update id="updateInfo2">
        UPDATE ${tableName}
        <set>
            <foreach collection="fieldNames1" item="fieldName" index="index" separator=",">
                <choose>
                    <when test='fieldTypes[fieldName] == "geometry"'>
                        ${fieldName} = ST_GeomFromWKB(decode(#{fieldValues1[${index}]}, 'hex'), 4490)
                    </when>
                    <when test='fieldTypes[fieldName] == "int4"'>
                        ${fieldName} = CAST(#{fieldValues1[${index}]} AS INTEGER)
                    </when>
                    <when test='fieldTypes[fieldName] == "int8"'>
                        ${fieldName} = CAST(#{fieldValues1[${index}]} AS BIGINT)
                    </when>
                    <!-- 关键修改：格式参数添加"T"，适配2024-05-20T14:30:00格式 -->
                    <when test='fieldTypes[fieldName] == "timestamp" or fieldTypes[fieldName] == "timestamp without time zone"'>
                        ${fieldName} = TO_TIMESTAMP(#{fieldValues1[${index}]}, 'yyyy-MM-dd"T"HH24:mi:ss.MSXXX')
                        + INTERVAL '8 hours'
                    </when>
                    <when test='fieldTypes[fieldName] == "numeric" or fieldTypes[fieldName] == "decimal" or fieldTypes[fieldName] == "float8"'>
                        ${fieldName} = CAST(#{fieldValues1[${index}]} AS NUMERIC)
                    </when>
                    <otherwise>
                        ${fieldName} = #{fieldValues1[${index}]}
                    </otherwise>
                </choose>
            </foreach>
        </set>
        WHERE
        <foreach collection="fieldNames2" item="fieldName" index="index" separator="AND">
            <choose>
                <when test='fieldTypes[fieldName] == "geometry"'>
                    ${fieldName} = ST_GeomFromWKB(decode(#{fieldValues2[${index}]}, 'hex'), 4490)
                </when>
                <when test='fieldTypes[fieldName] == "int4"'>
                    ${fieldName} = CAST(#{fieldValues2[${index}]} AS INTEGER)
                </when>
                <when test='fieldTypes[fieldName] == "int8"'>
                    ${fieldName} = CAST(#{fieldValues2[${index}]} AS BIGINT)
                </when>
                <!-- WHERE条件同步修改格式参数 -->
                <when test='fieldTypes[fieldName] == "timestamp" or fieldTypes[fieldName] == "timestamp without time zone"'>
                    ${fieldName} = TO_TIMESTAMP(#{fieldValues2[${index}]}, 'yyyy-MM-dd"T"HH24:mi:ss')
                </when>
                <when test='fieldTypes[fieldName] == "numeric" or fieldTypes[fieldName] == "decimal" or fieldTypes[fieldName] == "float8"'>
                    ${fieldName} = CAST(#{fieldValues2[${index}]} AS NUMERIC)
                </when>
                <otherwise>
                    ${fieldName} = #{fieldValues2[${index}]}
                </otherwise>
            </choose>
        </foreach>
    </update>

</mapper>
